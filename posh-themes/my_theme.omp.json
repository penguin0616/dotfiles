{
	"$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
	"palette": {
		"azure_blue": "#045796",
		"github_green": "#1c8139",
		"gitlab_orange": "#fca326",
		"pwsh_blue": "#0e335f",
		"root": "#ff4444",
		"ssh": "#ff7418",
		"white": "#eeeeee",
		"wsl": "#770077"
	},
	"upgrade": {
		"source": "cdn",
		"interval": "168h",
		"auto": false,
		"notice": false
	},
	"blocks": [
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"type": "text",
					"style": "plain"
				},
				{
					"template": "{{ if .Root }}\ue0b7{{.UserName}}\ue0b5{{ else }}{{.UserName}}{{ end }}",
					"foreground": "#c8ff05",
					"type": "session",
					"style": "plain",
					"foreground_templates": [
						"{{ if .Root }}p:root{{ end }}"
					]
				},
				{
					"template": "@",
					"foreground": "p:white",
					"type": "session",
					"style": "plain"
				},
				{
					"template": "{{ if .SSHSession }}<i>{{.HostName}}</i>{{ else }}{{.HostName}}{{ end }}",
					"foreground": "#c8ff05",
					"type": "session",
					"style": "plain",
					"foreground_templates": [
						"{{ if .SSHSession }}p:ssh{{ end }}",
						"{{ if .WSL }}p:wsl{{ end }}"
					]
				},
				{
					"options": {
						"folder_separator_icon": "/",
						"style": "full"
					},
					"template": " {{ .Path }} ",
					"foreground": "#0CA0D8",
					"type": "path",
					"style": "plain"
				},
				{
					"options": {},
					"template": "({{ if .Rebase }}{{ replaceP \"\ue0a0\" .Rebase.HEAD \"\"}} | REBASE {{ .Rebase.Current }}/{{ .Rebase.Total }}{{ else }}{{ .Ref }}{{ end }}) [ {{ if .BranchStatus }}{{ .BranchStatus }} {{ end }}{{ if .Working.Changed }}{{ .Working.String }} {{ end }}{{ if .Staging.Changed }}| {{ end }}{{ if .Staging.Changed }}{{ .Staging.String }} {{ end }}]",
					"foreground": "#ded15e",
					"type": "git",
					"style": "plain"
				}
			]
		},
		{
			"type": "prompt",
			"alignment": "right",
			"overflow": "hide",
			"leading_diamond": "\ue0b2",
			"trailing_diamond": "<transparent>\ue0b2</>",
			"segments": [
				{
					"options": {
						"always_enabled": false
					},
					"leading_diamond": "\ue0b2",
					"template": " {{ if gt .Code 0 }}Error [{{ .String }}]: {{ reason .Code }}{{ else }}\uf42e{{ end }} ",
					"foreground": "p:white",
					"background": "#1b2a35",
					"type": "status",
					"style": "diamond",
					"background_templates": [
						"{{ if gt .Code 0 }}#990000{{ end }}"
					]
				},
				{
					"options": {
						"fetch_virtual_env": true,
						"home_enabled": true
					},
					"leading_diamond": "\ue0b2",
					"template": " {{ if .Venv }}\ue235({{ .Venv }}){{ end }} ",
					"foreground": "#000000",
					"background": "#ffe600",
					"type": "python",
					"style": "diamond"
				},
				{
					"leading_diamond": "\ue0b2",
					"template": " {{ .Name }} ",
					"foreground": "p:white",
					"background": "#444444",
					"type": "shell",
					"style": "diamond",
					"background_templates": [
						"{{ if eq .Name \"bash\" }}#8dba3c{{ end }}",
						"{{ if eq .Name \"pwsh\" }}p:pwsh_blue{{ end }}"
					],
					"foreground_templates": [
						"{{ if eq .Name \"bash\" }}#000000{{ end }}",
						"{{ if eq .Name \"pwsh\" }}p:white{{ end }}"
					]
				},
				{
					"options": {
						"time_format": "03:04:05 PM MST"
					},
					"leading_diamond": "\ue0b2",
					"template": " {{ .CurrentDate | date .Format }} ",
					"foreground": "#fcfcfc",
					"background": "#444499",
					"type": "time",
					"style": "diamond",
					"min_width": 100
				},
				{
					"options": {
						"always_enabled": false,
						"threshold": 500
					},
					"leading_diamond": "\ue0b2",
					"template": " {{ .FormattedMs }} ",
					"foreground": "#fcfcfc",
					"background": "#111666",
					"type": "executiontime",
					"style": "diamond"
				}
			]
		},
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"template": "\u2570\u2500",
					"type": "text",
					"style": "plain"
				},
				{
					"options": {},
					"leading_diamond": "\ue0b7",
					"trailing_diamond": "\ue0b5",
					"template": "{{ .UpstreamIcon }}{{ .User.Name }}",
					"foreground": "p:white",
					"type": "git",
					"style": "diamond",
					"foreground_templates": [
						"{{ if matchP \"github.com\" .UpstreamURL }}p:github_green{{ end }}",
						"{{ if matchP \"gitlab.com\" .UpstreamURL }}p:gitlab_orange{{ end }}",
						"{{ if matchP \"dev.azure.com\" .UpstreamURL }}p:azure_blue{{ end }}",
						"{{ if matchP \"visualstudio.com\" .UpstreamURL }}p:azure_blue{{ end }}"
					]
				}
			],
			"newline": true
		},
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"template": " {{ if .Root }}#{{ else }}${{ end }}",
					"foreground": "p:white",
					"type": "text",
					"style": "plain",
					"foreground_templates": [
						"{{ if .Root }}p:white{{ end }}"
					]
				}
			]
		}
	],
	"version": 3,
	"final_space": true
}